# ==== Cấu hình chạy NỘI BỘ (Ollama) - không cần API key nào ====

# Thư mục lưu dữ liệu (đồ thị, vector index...) - toàn bộ là file local
WORKING_DIR=./workdir

# Địa chỉ Ollama đang chạy. Mặc định là máy local; nếu Ollama chạy trên máy
# khác trong mạng nội bộ, đổi thành http://<ip-may-do>:11434
OLLAMA_HOST=http://localhost:11434

# Model LLM đã `ollama pull` (ví dụ: qwen2.5:7b-instruct, llama3.1:8b, vinallama-7b-chat)
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct

# Model embedding đã `ollama pull` (ví dụ: nomic-embed-text, mxbai-embed-large)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Số chiều vector tương ứng với model embedding ở trên (nomic-embed-text = 768)
EMBEDDING_DIM=768

# Tuỳ chọn khác
SESSION_TTL_SECONDS=3600
MAX_HISTORY_TURNS=10
MAX_QUESTION_CHARS=4000
